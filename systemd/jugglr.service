[Unit]
Description=Jugglr - Linux File Automation & Defense Daemon
Documentation=https://github.com/example/jugglr
After=network.target local-fs.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/jugglr --daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
Environment="RUST_LOG=info"

# Security & Sandboxing hardening
ProtectSystem=full
ProtectHome=read-only
# Allow write access to watched directories and target locations
ReadWritePaths=%h/Downloads %h/Documents %h/Pictures %h/.local/share/jugglr
NoNewPrivileges=true

[Install]
WantedBy=default.target
